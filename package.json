{
  "name": "vincent-ux",
  "version": "1.5.0",
  "private": true,
  "description": "桌面级 agent 工作台的界面设计系统：原则、设计变量、图标、组件、模式、模板",
  "type": "module",
  "scripts": {
    "build": "node scripts/build-tokens.mjs && node scripts/build-icons.mjs && node scripts/stamp.mjs",
    "check": "node scripts/check.mjs",
    "showcase": "vite --host 127.0.0.1 --port 5190 --strictPort",
    "icons": "node scripts/build-icons.mjs",
    "sync": "node scripts/sync.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs && playwright test",
    "build:showcase": "vite build",
    "check:privacy": "node scripts/check-privacy.mjs"
  },
  "dependencies": {
    "@base-ui/react": "1.9.0",
    "lucide-react": "1.61.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.64.1",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "typescript": "7.0.2",
    "vite": "8.3.5"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/shcjveg/vincent-ux.git"
  },
  "bugs": {
    "url": "https://github.com/shcjveg/vincent-ux/issues"
  },
  "homepage": "https://github.com/shcjveg/vincent-ux#readme",
  "keywords": [
    "design-system",
    "agent",
    "react",
    "design-tokens",
    "css",
    "accessibility"
  ]
}
